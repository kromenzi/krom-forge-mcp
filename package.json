{
  "name": "krom-forge-mcp",
  "version": "59.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "verify:mcp": "node scripts/verify-mcp-consistency.mjs",
    "verify:automation": "node scripts/verify-automation.mjs",
    "verify:v55": "tsx scripts/verify-v55-runtime.ts",
    "verify:v56": "tsx scripts/verify-v56-runtime.ts",
    "verify:v57": "tsx scripts/verify-v57-brain.ts",
    "verify:v58": "tsx scripts/verify-v58-os.ts",
    "verify:v59": "tsx scripts/verify-v59-fabric.ts",
    "manifest:mcp": "node scripts/generate-mcp-manifest.mjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run verify:mcp -- --manifest-output .artifacts/mcp-manifest.json && npm run verify:automation && npm run verify:v55 && npm run verify:v56 && npm run verify:v57 && npm run verify:v58 && npm run verify:v59 && npm run typecheck && npm test && npm run audit:production && npm run build",
    "build": "next build",
    "start": "next start"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-handler": "^2.2.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  }
}
